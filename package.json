{
  "name": "speed-tracker",
  "workspaces": [
    "packages/*"
  ],
  "version": "0.1.0",
  "description": "track your speed on track =)",
  "scripts": {
    "transpile": "run-p transpile:common transpile:server transpile:server-db",
    "start": "run-p start:server",
    "start:server": "npm run start --workspace @speed-tracker/server",
    "transpile:common": "npm run transpile --workspace @speed-tracker/common",
    "transpile:server": "npm run transpile --workspace @speed-tracker/server",
    "transpile:server-db": "npm run transpile --workspace @speed-tracker/server-db",
    "test": "jest --config=jest.config.js --conditions=development"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperDubPro/speed-tracker.git"
  },
  "author": "Dubinin Nickolay",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/SuperDubPro/speed-tracker/issues"
  },
  "homepage": "https://github.com/SuperDubPro/speed-tracker#readme",
  "devDependencies": {
    "@nx/eslint": "19.8.2",
    "@nx/jest": "20.3.0",
    "@nx/vite": "^19.8.2",
    "@nx/web": "19.8.2",
    "@nx/webpack": "^19.8.2",
    "@tsconfig/recommended": "^1.0.3",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@vitest/ui": "^1.3.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "jest-module-name-mapper": "^0.1.5",
    "npm-run-all": "^4.1.5",
    "nx": "20.3.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.0",
    "vitest": "^1.3.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {}
}